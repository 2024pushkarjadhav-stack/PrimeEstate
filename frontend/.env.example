# PrimeEstate Frontend Environment Variables
# In local development:
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# In production deployment on Vercel:
# Set VITE_API_BASE_URL to your deployed Render backend service URL:
# Example: VITE_API_BASE_URL=https://primeestate-backend.onrender.com/api
# Example: VITE_SOCKET_URL=https://primeestate-backend.onrender.com
